{
    "name": "majiix/joopeter-email-to-product-buyers-for-woocommerce",
    "description": "Adds a meta box to the product edit page to send custom emails to customers who bought that product.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10 || ^2.0",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "php-stubs/woocommerce-stubs": "^8.0 || ^9.0"
    },
    "config": {
        "allow-plugins": {
            "szepeviktor/phpstan-wordpress": true
        }
    }
}
